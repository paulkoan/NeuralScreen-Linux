+}
+
+void Kernels::compositeToRgba8(VkCommandBuffer commands, const vk::Buffer& proxy, const Activation& head,
+                               const vk::Buffer& output, uint32_t proxyWidth, uint32_t headWidth,
+                               uint32_t validWidth, uint32_t validHeight) {
