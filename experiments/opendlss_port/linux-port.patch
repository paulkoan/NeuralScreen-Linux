+// The first type matching `preferred`, or the first matching `fallback`.
+//
+// Requiring HOST_VISIBLE alone lands on the write-combined type, which is what a GPU
+// usually offers first: writes to it are cheap and reads are not, and a 60MB readback
+// through it measured 400ms in the pipeline — 150MB/s, which is the memory type and not
+// the copy. HOST_CACHED is what makes reading a tensor back worth doing; where a device
+// has no cached host type, the old behaviour is kept rather than failing to allocate.
+uint32_t Context::findMemoryTypeOr(uint32_t typeBits, VkMemoryPropertyFlags preferred,
+                                   VkMemoryPropertyFlags fallback) {
+  try {
+    return findMemoryType(typeBits, preferred);
+  } catch (const std::exception&) {
+    return findMemoryType(typeBits, fallback);
+  }
+}
