 shaders/proxy_expand.comp    |  32 ++
 src/kernels.cpp              |  45 ++-
 src/kernels.h                |  27 +-
 src/main.cpp                 |   6 +-
 src/nr_model.h               |   1 +
 src/serve.cpp                | 686 +++++++++++++++++++++++++++++++++++
 src/vk_context.cpp           |  26 +-
