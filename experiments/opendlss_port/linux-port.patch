+// --- the wire format (protocol.py, native/dlss5-feed-host64.cpp) --------------
+
+constexpr uint32_t kVideoMagic = 0x33563544u;   // 'DV5'3
+constexpr uint32_t kFrameMagic = 0x314D5246u;   // 'FMR1'
+constexpr uint32_t kOutMagic   = 0x3154554Fu;   // 'OUT1'
+constexpr uint32_t kShmMagic   = 0x494D4853u;   // 'SHMI'
+constexpr uint32_t kShmAck     = 0x4B434153u;   // 'SACK'
+constexpr uint32_t kMotionMagic = 0x53544F4Du;  // 'MOTS'
+constexpr uint32_t kMotionAck  = 0x4B43414Du;   // 'MACK'
+constexpr uint32_t kWindowMagic = 0x4F444E57u;  // 'WNDO'
+constexpr uint32_t kWindowAck  = 0x4B434157u;   // 'WACK'
+constexpr uint32_t kResizeMagic = 0x5A534E52u;  // 'RNSZ'
+constexpr uint32_t kResizeAck  = 0x4B434152u;   // 'RACK'
+constexpr uint32_t kDdaMagic   = 0x31414444u;   // 'DDA1'
+constexpr uint32_t kDdaAck     = 0x4B434144u;   // 'DACK'
+constexpr uint32_t kOutsMagic  = 0x5354554Fu;   // 'OUTS'
+constexpr uint32_t kOutsAck    = 0x324B414Fu;   // 'OAK2'
+constexpr uint32_t kGrayMagic  = 0x59415247u;   // 'GRAY'
+constexpr uint32_t kGrayAck    = 0x4B434147u;   // 'GAK'
+constexpr uint32_t kWgcMagic   = 0x57434757u;   // 'WGCW'
+constexpr uint32_t kWgcAck     = 0x4B414757u;   // 'WGAK'
+
+constexpr uint32_t kFrameFlagShm = 0x1;        // the frame is in the SHMI mapping
+constexpr uint32_t kFrameFlagWantPixels = 0x2;
+
+// VideoResultHeader.bytes when the pixels are in the OUTS mapping, not the pipe.
+constexpr uint32_t kOutBytesInShm = 0xFFFFFFFFu;
+constexpr uint32_t kFrameFlagMotionSmall = 0x4;
+constexpr uint32_t kFrameFlagNoColor = 0x8;
+constexpr uint32_t kFrameFlagBypass = 0x10;
+// No motion field follows this header: nothing in this mode reads one, and at
+// 2560x1440 the field is 14.7MB of float16 - as much as the colour.
+constexpr uint32_t kFrameFlagNoMotion = 0x40;
+
+constexpr size_t kHeaderBytes = 64;        // HEADER_FMT  "<10I4f2I"
+constexpr size_t kFrameHeaderBytes = 24;   // FRAME_FMT   "<4Iq"
+constexpr size_t kOutHeaderBytes = 28;     // OUT_FMT     "<5Iq"
+constexpr size_t kAckBytes = 24;           // SHM_ACK_FMT and every other ack
+constexpr size_t kShmBytes = 88;           // SHM_FMT     "<4Iq64s"
+
+// The Python side has one static_assert behind each of these too
+// (tests/test_protocol_sizes.py checks the two sides against each other). A size that
+// drifts here desynchronises the stream on the first frame, so it fails at compile time
+// rather than as a plausible-looking wrong frame.
+static_assert(kHeaderBytes == 10 * 4 + 4 * 4 + 2 * 4, "HEADER_FMT is 64 bytes");
+static_assert(kFrameHeaderBytes == 4 * 4 + 8, "FRAME_FMT is 24 bytes");
+static_assert(kOutHeaderBytes == 5 * 4 + 8, "OUT_FMT is 28 bytes");
+static_assert(kAckBytes == 4 * 4 + 8, "the acks are 24 bytes");
+static_assert(kShmBytes == 4 * 4 + 8 + 64, "SHM_FMT is 88 bytes");
+
+// The composite moved to the GPU (shaders/composite_serve.comp): the host spelling of it
+// was 11M pixels of fma, floor and half-truncation a frame, and it forced the head's 60MB
+// of f32 through the readback instead of the finished 14.7MB image. src/main.cpp keeps its
+// own copy — parity compares a fixture against that one — and the shader carries the same
+// arithmetic, so the served picture and the gate still agree.
+
+// --- shared memory ------------------------------------------------------------
+//
+// The client can put the frame in a POSIX shared-memory object and take the pixels back
+// from another one (SHMI/SACK, OUTS/OAK2). It matters now that the network is 12ms of a
+// frame: through a pipe 14.7MB of colour plus 14.7MB of motion go in and 14.7MB comes
+// back, which is the largest single cost left. Through a mapping the same round trip
+// measured ~2ms in Phase A.
+//
+// Both objects are created by the client with `mmap(-1, size, tagname=name)`, which on
+// Linux is /dev/shm/<name> - the namespace this process opens. Under Wine that tagname was
+// a named section and a native worker could not have shared it; this mode exists precisely
+// because there is no Wine in the path.
+
+struct SharedInput {
+  int fd = -1;
+  uint8_t* map = nullptr;
+  size_t bytes = 0;           // the mapping's size
+  size_t colourCapacity = 0;  // what the client said it writes at offset 0
+  size_t motionCapacity = 0;  // and for the motion field after it
+};
+
+// The pixel channel: [0, 8) is the client's seqlock (odd while a frame is being written),
+// the image follows. A torn frame is detected by the reader, so the seqlock is not
+// decoration.
+struct SharedOutput {
+  int fd = -1;
+  uint8_t* map = nullptr;
+  size_t bytes = 0;
+  uint32_t width = 0, height = 0;
+  uint64_t sequence = 0;
+};
+
+int openShared(const char* name, size_t minimum, bool create) {
+  const int fd = create ? ::shm_open(name, O_RDWR | O_CREAT, 0600) : ::shm_open(name, O_RDWR, 0);
+  if (fd < 0) throw std::runtime_error(std::string("shm_open(") + name + "): " + strerror(errno));
+  struct stat info {};
+  if (fstat(fd, &info) != 0) { ::close(fd); throw std::runtime_error("fstat on a shared object"); }
+  if ((size_t)info.st_size < minimum) {
+    ::close(fd);
+    throw std::runtime_error(std::string("shared object ") + name + " holds " +
+                             std::to_string((long long)info.st_size) + " bytes, needs " +
+                             std::to_string((long long)minimum));
+  }
+  return fd;
+}
+
+void* mapShared(int fd, size_t bytes) {
+  void* at = ::mmap(nullptr, bytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  if (at == MAP_FAILED) throw std::runtime_error(std::string("mmap: ") + strerror(errno));
+  return at;
+}
+
+// --- io ------------------------------------------------------------------------
+
+uint32_t le32(const uint8_t* bytes) {
+  uint32_t value = 0;                       // the wire format and x86-64 are both little-endian
+  memcpy(&value, bytes, 4);
+  return value;
+}
+
+int64_t le64(const uint8_t* bytes) {
+  int64_t value = 0;
+  memcpy(&value, bytes, 8);
+  return value;
+}
+
+void put32(uint8_t* bytes, uint32_t value) { memcpy(bytes, &value, 4); }
+
+// Reads exactly `bytes` from stdin. False means the stream ended (the client closed the
+// pipe, or stopped), which is a normal way for this process to end.
+bool readExact(void* destination, size_t bytes) {
+  uint8_t* out = static_cast<uint8_t*>(destination);
+  size_t got = 0;
+  while (got < bytes) {
+    const ssize_t n = ::read(0, out + got, bytes - got);
+    if (n == 0) return false;
+    if (n < 0) {
+      if (errno == EINTR) continue;
+      throw std::runtime_error(std::string("read(stdin): ") + strerror(errno));
+    }
+    got += (size_t)n;
+  }
+  return true;
+}
+
+void writeAll(const void* source, size_t bytes) {
+  const uint8_t* in = static_cast<const uint8_t*>(source);
+  size_t sent = 0;
+  while (sent < bytes) {
+    const ssize_t n = ::write(1, in + sent, bytes - sent);
+    if (n < 0) {
+      if (errno == EINTR) continue;
+      throw std::runtime_error(std::string("write(stdout): ") + strerror(errno));
+    }
+    sent += (size_t)n;
+  }
+}
+
+std::string argValue(int argc, char** argv, const char* name, const std::string& fallback = "") {
+  for (int i = 1; i + 1 < argc; ++i) if (!strcmp(argv[i], name)) return argv[i + 1];
+  return fallback;
+}
+
+std::string executableDirectory(const char* argv0) {
+  std::string path = argv0;
+  size_t slash = path.find_last_of("/\\");
+  return slash == std::string::npos ? "." : path.substr(0, slash);
+}
+
+// What this binary was built from. It is printed by `dlss5vk stamp`, logged by serve,
+// and compared by the pipeline against the patch its own checkout holds — the answer to
+// "are we running what we think we are" comes from the binary, not from anyone's memory
+// of which commands ran.
+const char* buildStamp() {
+  return "port " DLSS5VK_PORT_COMMIT " (" DLSS5VK_PORT_MODIFIED " modified) patch " DLSS5VK_PATCH_ID;
+}
+
+// After a frame: a chained wait that gave up means its output is wrong (docs/execution.md,
+// "Barrier-free chaining"). Same check as every other mode in main.cpp.
+void checkChainTimeouts(const nr::Kernels& kernels) {
+  const nr::Kernels::ChainTimeouts timeouts = kernels.chainTimeouts();
+  if (timeouts.waits)
+    throw std::runtime_error(std::to_string(timeouts.waits) + " chained wait(s) timed out, the first on " + timeouts.counter +
+                             ": the frame is invalid (DLSS5VK_CHAIN=0 runs without chaining)");
+}
+
+// --- the startup header --------------------------------------------------------
+
+struct Startup {
+  uint32_t workWidth = 0, workHeight = 0, warmup = 0, frameCount = 0, profile = 0, preset = 0,
+           style = 0, autoMask = 0, uiCorrection = 0;
+  float intensity = 1.0f, localTone = 1.0f, localStructure = 1.0f, skinStructure = 1.0f;
+  uint32_t fullWidth = 0, fullHeight = 0;
+};
+
+Startup parseStartup(const uint8_t* bytes) {
+  Startup s;
+  s.workWidth = le32(bytes + 4);
+  s.workHeight = le32(bytes + 8);
+  s.warmup = le32(bytes + 12);
+  s.frameCount = le32(bytes + 16);
+  s.profile = le32(bytes + 20);
+  s.preset = le32(bytes + 24);
+  s.style = le32(bytes + 28);
+  s.autoMask = le32(bytes + 32);
+  s.uiCorrection = le32(bytes + 36);
+  memcpy(&s.intensity, bytes + 40, 4);
+  memcpy(&s.localTone, bytes + 44, 4);
+  memcpy(&s.localStructure, bytes + 48, 4);
+  memcpy(&s.skinStructure, bytes + 52, 4);
+  s.fullWidth = le32(bytes + 56);
+  s.fullHeight = le32(bytes + 60);
+  return s;
+}
+
+void sendAck(uint32_t magic, uint32_t ok, uint32_t a = 0, uint32_t b = 0, int64_t pts = 0) {
+  uint8_t ack[kAckBytes];
+  put32(ack, magic);
+  put32(ack + 4, ok);
+  put32(ack + 8, a);
+  put32(ack + 12, b);
+  memcpy(ack + 16, &pts, 8);
+  writeAll(ack, sizeof(ack));
+}
+
+// Publishes the image where the client is waiting for it, or down the pipe.
+//
+// The seqlock is the client's: it reads the first eight bytes, refuses an odd value (the
+// writer is mid-frame) and retries, so a torn frame is dropped rather than shown. The
+// writes are therefore ordered - odd, the pixels, then even - and the sequence only grows.
+void publishImage(SharedOutput& out, const std::vector<uint8_t>& pixels,
+                  const std::vector<uint8_t>** inlinePixels, uint32_t* replyBytes) {
+  if (!out.map) {          // the client did not ask for the pixel channel
+    *inlinePixels = &pixels;
+    *replyBytes = (uint32_t)pixels.size();
+    return;
+  }
+  if (out.bytes < pixels.size() + 8) throw std::runtime_error("the pixel channel is too small");
+  const uint64_t writing = ++out.sequence;
+  memcpy(out.map, &writing, 8);
+  __sync_synchronize();
+  memcpy(out.map + 8, pixels.data(), pixels.size());
+  __sync_synchronize();
+  const uint64_t done = ++out.sequence;
+  memcpy(out.map, &done, 8);
+  *inlinePixels = nullptr;
+  *replyBytes = kOutBytesInShm;
+}
+
+void sendFrame(uint32_t index, uint32_t ok, uint32_t bytes, uint32_t ngxResult, int64_t pts,
+               const std::vector<uint8_t>* pixels) {
+  uint8_t header[kOutHeaderBytes];
+  put32(header, kOutMagic);
+  put32(header + 4, index);
+  put32(header + 8, ok);
+  put32(header + 12, bytes);
+  put32(header + 16, ngxResult);
+  memcpy(header + 20, &pts, 8);
+  writeAll(header, sizeof(header));
+  if (pixels) writeAll(pixels->data(), pixels->size());
+}
+
+}  // namespace
+
+// `dlss5vk stamp`: what this binary was built from, and nothing else. No device, no
+// model, no arguments — cheap enough for a pipeline to call before every run.
+int runStamp(int argc, char** argv) {
+  (void)argc;
+  (void)argv;
+  printf("%s\n", buildStamp());
+  return 0;
+}
+
+int runServe(int argc, char** argv) {
+  const std::string modelDir = argValue(argc, argv, "--model");
+  const std::string shaderDir = argValue(argc, argv, "--shaders", executableDirectory(argv[0]) + "/shaders");
+  const int frameLimit = atoi(argValue(argc, argv, "--frames", "0").c_str());
+  if (modelDir.empty()) {
+    fprintf(stderr, "usage: dlss5vk serve --model <dir> [--shaders <dir>] [--frames N]\n");
+    return 2;
+  }
+
+  uint8_t header[kHeaderBytes];
+  if (!readExact(header, sizeof(header))) {
+    fprintf(stderr, "serve: no startup header arrived on stdin\n");
+    return 2;
+  }
+  if (le32(header) != kVideoMagic) {
+    fprintf(stderr, "serve: expected a stream header (VIDEO_MAGIC 0x%08X), got 0x%08X\n", kVideoMagic, le32(header));
+    return 2;
+  }
+  const Startup startup = parseStartup(header);
+  const uint32_t workWidth = startup.workWidth, workHeight = startup.workHeight;
+  if (workWidth == 0 || workHeight == 0) {
+    fprintf(stderr, "serve: the stream header carried a work size of %ux%u\n", workWidth, workHeight);
+    return 2;
+  }
+  if ((startup.fullWidth && startup.fullWidth != workWidth) || (startup.fullHeight && startup.fullHeight != workHeight)) {
+    fprintf(stderr, "serve: the client expects NGX upscaling (%ux%u -> %ux%u); this worker runs the network at one "
+                    "size. Run the pipeline without --work-scale.\n",
+            workWidth, workHeight, startup.fullWidth, startup.fullHeight);
+    return 2;
+  }
+
+  const uint32_t seed = (uint32_t)atoi(getenv("DLSS5VK_SERVE_SEED") ? getenv("DLSS5VK_SERVE_SEED") : "0");
+  fprintf(stderr, "serve: %ux%u, model %s, shaders %s, seed %u\n", workWidth, workHeight, modelDir.c_str(),
+          shaderDir.c_str(), seed);
+  fprintf(stderr, "serve: built from %s\n", buildStamp());
+  if (startup.intensity != 1.0f)
+    fprintf(stderr, "serve: the header asks for intensity %.3f; this path has no intensity blend, it is ignored\n",
+            startup.intensity);
+  if (startup.uiCorrection) fprintf(stderr, "serve: ui_correction %u is ignored\n", startup.uiCorrection);
+
+  nr::Kernels::PreprocessArgs preprocess;
+  preprocess.fullWidth = 0;           // filled once the geometry is known
+  preprocess.fullHeight = 0;
+  preprocess.validWidth = workWidth;
+  preprocess.validHeight = workHeight;
+  preprocess.sourceWidth = workWidth;
+  preprocess.sourceHeight = workHeight;
+  preprocess.seed = seed;
+  preprocess.autoMask = startup.autoMask != 0;
+  preprocess.localTone = startup.localTone;
+  preprocess.localStructure = startup.localStructure;
+  preprocess.skinStructure = startup.skinStructure;
+  // preprocess.comp builds lane 10 as style / 128, so the header's style is a 1/128
+  // fixed-point fraction: the pipeline's default of 1 is 0.008, i.e. the neutral end.
+  preprocess.style = (float)startup.style;
+
+  bool motionSaidNothing = false;
+
+  SharedInput input;
+  SharedOutput output;
+
+  std::unique_ptr<vk::Context> context;
+  std::unique_ptr<nr::Model> model;
+  std::unique_ptr<nr::Kernels> kernels;
+  std::unique_ptr<nr::Graph> graph;
+  vk::Buffer proxy{};
+  vk::Buffer colourBuffer{};  // the client's RGBA8 frame, from the pipe or the mapping
+  vk::Buffer imageBuffer{};      // RGBA8, the composite's output and what leaves the device
+  vk::Buffer historyProxy{};     // the last published frame, as a proxy the next one reads
+  vk::Buffer motionBuffer{};     // the client's motion field, 2 x f16 per pixel, as it arrived
+  nr::Activation* features = nullptr;
+  uint32_t fullWidth = 0, fullHeight = 0;
+  bool haveHistory = false;      // a frame has been served, so lanes 7-9 have one to read
+  // The model's learned cap on the blend weight (block70.layer0.blend_scale, a single f16).
+  // Read from the model, not written into the source: it is a weight, and a hard-coded one
+  // would silently disagree with the next model file.
+  float blendScale = 1.0f;
+
+  auto startEngine = [&]() {
+    context = std::make_unique<vk::Context>();
+    fprintf(stderr, "serve: device %s\n", context->deviceName().c_str());
+    // verifyHashes = true: each stage file is checked against the manifest's sha256, which
+    // is what upstream does on load and what our extractor writes. bench passes false to
+    // keep its timing loop honest, but this mode serves frames — a stage file that is
+    // truncated or half-written is otherwise silent, and the model directory is the one
+    // input to this whole path that nobody can look at. It costs a few seconds, once.
+    model = std::make_unique<nr::Model>(*context, modelDir, true);
+    // The temporal blend's learned cap, out of the model the way the demo reads it
+    // (demo/nr_pass.cpp): one f16 at the front of block 70's blend_scale tensor. Absent or
+    // short, the demo's own fallback of 1.0 stands - and it is printed either way, so a
+    // weight that did not arrive is visible in the log before a picture is questioned.
+    {
+      bool found = false;
+      try {
+        const nr::Tensor& blend = model->tensor(70, 0, "blend_scale");
+        if (blend.byteLength >= 2) {
+          blendScale = num::f16ToF32(nr::auxHalf(blend, 0, 0));
+          found = true;
+        }
+      } catch (...) {
+        // Model::tensor throws on a missing tensor, and a model without this weight is a
+        // model this path can still serve: 1.0 is the demo's own fallback. Catch-all on
+        // purpose - the only thing that can come out of here is the lookup above, and
+        // refusing to serve over it would be a hard failure for a soft reason.
+      }
+      fprintf(stderr, "serve: blend scale %.4f (%s)\n", blendScale,
+              found ? "block70.layer0.blend_scale" : "absent - defaulted to 1.0, the demo's fallback");
+    }
+    kernels = std::make_unique<nr::Kernels>(*context, shaderDir);
+    kernels->setSiluTable(ref::siluTable());
+    const nr::Geometry geometry = nr::Geometry::fromValid(workWidth, workHeight);
+    fullWidth = geometry.fullWidth;
+    fullHeight = geometry.fullHeight;
+    graph = std::make_unique<nr::Graph>(*context, *model, *kernels, geometry,
+                                        nr::Graph::Options{.fusedBlocks = true});
+    features = graph->allocate("input features", fullWidth * fullHeight, 16, nr::Format::F32);
+    proxy = context->createBuffer((VkDeviceSize)workWidth * workHeight * 16, false, "proxy");
+    colourBuffer =
+        context->createBuffer((VkDeviceSize)workWidth * workHeight * 4, false, "rgba8 frame");
+    imageBuffer = context->createBuffer((VkDeviceSize)workWidth * workHeight * 4, false, "rgba8 image");
+    // The history surface: the frame this one published last, expanded to a proxy of its own.
+    // A buffer and a dispatch, no host bytes: how the composite publishes a frame is what the
+    // next frame's lanes 7-9 read (docs/frame.md's history, at this path's 8 bits).
+    historyProxy = context->createBuffer((VkDeviceSize)workWidth * workHeight * 16, false, "history proxy");
+    context->fillZero(historyProxy);
+    // The motion field, in the wire's own layout: 2 x f16 per pixel, current -> previous, in
+    // work-resolution pixels. Zeroed here and left zeroed by a caller that declares no field,
+    // which is what makes "no motion" the identity reprojection without a branch in the shader
+    // and without uploading 14.7MB of nothing every frame.
+    motionBuffer = context->createBuffer((VkDeviceSize)workWidth * workHeight * 4, false, "motion field");
+    context->fillZero(motionBuffer);
+    preprocess.fullWidth = fullWidth;
+    preprocess.fullHeight = fullHeight;
+    // The warm record: every PTX kernel is JIT-compiled on first use, so the first frame
+    // would otherwise pay for 249 launches. Recording once against a zero proxy pays it
+    // here, where the log says what the wait was.
+    context->fillZero(proxy);
+    context->fillZero(colourBuffer);
+    const std::chrono::steady_clock::time_point began = std::chrono::steady_clock::now();
+    fprintf(stderr, "serve: warming up (the PTX modules are JIT-compiled on first use)\n");
+    VkCommandBuffer commands = context->beginCommands();
+    kernels->expandRgba8ToProxy(commands, colourBuffer, proxy, workWidth, workHeight);
+    kernels->preprocessFromProxy(commands, proxy, *features, preprocess);
+    graph->record(commands, *features);
+    context->endAndSubmit(commands, true);
+    checkChainTimeouts(*kernels);
+    fprintf(stderr, "serve: warm-up %.0f ms\n",
+            std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - began).count());
+  };
+
+  std::vector<uint8_t> colour((size_t)workWidth * workHeight * 4);
+  std::vector<uint8_t> motion((size_t)workWidth * workHeight * 4);   // 2 x f16 per pixel
+
+  uint32_t frames = 0;
+  double totalMs = 0;
+  try {
+    while (true) {
+      uint8_t magicBytes[4];
+      if (!readExact(magicBytes, sizeof(magicBytes))) {
+        fprintf(stderr, "serve: input stream closed after %u frame(s)\n", frames);
+        return 0;
+      }
+      const uint32_t magic = le32(magicBytes);
+
+      if (magic != kFrameMagic) {
+        // A command. SHMI and OUTS are implemented; everything else is answered ok=0 rather
+        // than ignored, which keeps a caller from waiting for an acknowledgement that will
+        // never come.
+        const size_t restBytes =
+            magic == kShmMagic || magic == kOutsMagic ? kShmBytes - 4 : kAckBytes - 4;
+        std::vector<uint8_t> rest(restBytes);
+        if (!readExact(rest.data(), rest.size())) return 0;
+        if (magic == kShmMagic || magic == kOutsMagic) {
+          char name[65] = {0};
+          memcpy(name, rest.data() + 20, 64);
+          try {
+            if (magic == kShmMagic) {
+              input.colourCapacity = le32(rest.data());
+              input.motionCapacity = le32(rest.data() + 4);
+              const size_t want = input.colourCapacity + input.motionCapacity;
+              if (!input.map) {
+                input.bytes = want;
+                input.fd = openShared(name, want, false);
+                input.map = (uint8_t*)mapShared(input.fd, want);
+              }
+              fprintf(stderr, "serve: frame channel open (%.1f MB, %s)\n",
+                      (double)input.bytes / 1e6, name);
+              sendAck(kShmAck, 1);
+            } else {
+              output.width = le32(rest.data());
+              output.height = le32(rest.data() + 4);
+              output.bytes = (size_t)output.width * output.height * 4 + 8;
+              if (!output.map) {
+                output.fd = openShared(name, output.bytes, false);
+                output.map = (uint8_t*)mapShared(output.fd, output.bytes);
+              }
+              fprintf(stderr, "serve: pixel channel open (%ux%u, %.1f MB, %s)\n",
+                      output.width, output.height, (double)output.bytes / 1e6, name);
+              sendAck(kOutsAck, 1);
+            }
+          } catch (const std::exception&error) {
+            // Refusing is not fatal to the caller: it keeps sending down the pipe.
+            fprintf(stderr, "serve: %s - falling back to the pipe\n", error.what());
+            sendAck(magic == kShmMagic ? kShmAck : kOutsAck, 0);
+          }
+          continue;
+        }
+        uint32_t answer = 0;
+        switch (magic) {
+          case kShmMagic:    answer = kShmAck;    break;
+          case kMotionMagic: answer = kMotionAck; break;
+          case kWindowMagic: answer = kWindowAck; break;
+          case kResizeMagic: answer = kResizeAck; break;
+          case kDdaMagic:    answer = kDdaAck;    break;
+          case kOutsMagic:   answer = kOutsAck;   break;
+          case kGrayMagic:   answer = kGrayAck;   break;
+          case kWgcMagic:    answer = kWgcAck;    break;
+          default:
+            fprintf(stderr, "serve: unknown command 0x%08X on stdin\n", magic);
+            return 2;
+        }
+        fprintf(stderr, "serve: refusing command 0x%08X (not implemented here)\n", magic);
+        sendAck(answer, 0);
+        continue;
+      }
+
+      uint8_t frameHeader[kFrameHeaderBytes];
+      memcpy(frameHeader, magicBytes, 4);
+      if (!readExact(frameHeader + 4, sizeof(frameHeader) - 4)) {
+        fprintf(stderr, "serve: the stream ended inside a frame header\n");
+        return 0;
+      }
+      const uint32_t index = le32(frameHeader + 4);
+      const uint32_t reset = le32(frameHeader + 8);
+      const uint32_t flags = le32(frameHeader + 12);
+      const int64_t pts = le64(frameHeader + 16);
+
+      if (flags & kFrameFlagNoColor) {
+        fprintf(stderr, "serve: a frame arrived with NO_COLOR (the worker is expected to capture the screen itself); "
+                        "that is the Wine worker's DDA mode and is not implemented here\n");
+        return 2;
+      }
+      const bool noMotion = (flags & kFrameFlagNoMotion) != 0;
+      if (noMotion && !motionSaidNothing) {
+        motionSaidNothing = true;
+        fprintf(stderr, "serve: the caller declared no motion field: the reprojection is the identity\n"
+                        "serve: and the five-tap history filter is the centre tap, which is the pixel\n"
+                        "serve: itself - so no published byte can move for it\n");
+      }
+      if ((flags & kFrameFlagShm) && input.map) {
+        // The frame is in the mapping: only its header came down the pipe.
+        if (input.colourCapacity < colour.size() || input.motionCapacity < motion.size()) {
+          fprintf(stderr,
+                  "serve: the frame channel is %zu+%zu bytes, a %ux%u frame needs %zu+%zu\n",
+                  input.colourCapacity, input.motionCapacity, workWidth, workHeight,
+                  colour.size(), motion.size());
+          return 2;
+        }
+        memcpy(colour.data(), input.map, colour.size());
+        if (!noMotion) memcpy(motion.data(), input.map + input.colourCapacity, motion.size());
+      } else {
+        if (!readExact(colour.data(), colour.size())) {
+          fprintf(stderr, "serve: the stream ended inside frame %u's colour\n", index);
+          return 0;
+        }
+        if (!noMotion && !readExact(motion.data(), motion.size())) {
+          fprintf(stderr, "serve: the stream ended inside frame %u's motion\n", index);
+          return 0;
+        }
+      }
+
+      if (flags & kFrameFlagBypass) {
+        // NR off: the pipeline still wants its frame back, unprocessed. No device is
+        // touched for this, which is also what makes the protocol testable without a GPU.
+        // The history is dropped rather than fed back: this frame does not go through the
+        // composite, so imageBuffer still holds an older frame (or none at all).
+        haveHistory = false;
+        frames++;
+        const std::vector<uint8_t>* inlinePixels = nullptr;
+        uint32_t replyBytes = 0;
+        publishImage(output, colour, &inlinePixels, &replyBytes);
+        sendFrame(index, 1, replyBytes, 0, pts, inlinePixels);
+      } else {
+        if (!context) startEngine();
+        const std::chrono::steady_clock::time_point began = std::chrono::steady_clock::now();
+        if (reset) {
+          haveHistory = false;
+          fprintf(stderr, "serve: frame %u carries reset: no history for this frame, and this frame primes the next\n", index);
+        }
+
+        // The proxy, on the GPU: the frame goes up as it was captured (RGBA8, 3.7MB - a
+        // quarter of the f32 proxy, which was 11M float writes a frame down here) and one
+        // dispatch expands it to what preprocess.comp reads. The rounding to f16 is
+        // preprocess's own, so it is not repeated here.
+        context->upload(colourBuffer, colour.data(), (VkDeviceSize)colour.size());
+        // And the motion field, when the caller sent one. It goes up in the wire's own layout,
+        // so the shader reads the field the client computed rather than a conversion of it; a
+        // caller that declared no field leaves the buffer zeroed from startup, which is the
+        // identity reprojection at no cost per frame.
+        if (!noMotion) context->upload(motionBuffer, motion.data(), (VkDeviceSize)motion.size());
+        const std::chrono::steady_clock::time_point afterUpload = std::chrono::steady_clock::now();
+        context->resetDescriptorPool();
+        VkCommandBuffer commands = context->beginCommands();
+        // The history, first in this recording, because imageBuffer still holds the frame that
+        // was published last and this is the only moment it does - the composite below overwrites
+        // it. The same expand the current frame gets, on the previous one: one dispatch and no
+        // host bytes.
+        if (haveHistory) kernels->expandRgba8ToProxy(commands, imageBuffer, historyProxy, workWidth, workHeight);
+        kernels->expandRgba8ToProxy(commands, colourBuffer, proxy, workWidth, workHeight);
+        preprocess.history = haveHistory ? &historyProxy : nullptr;
+        kernels->preprocessFromProxy(commands, proxy, *features, preprocess);
+        graph->record(commands, *features);
+        // The composite, on the GPU: the head and the proxy in, RGBA8 out. Two reasons it is
+        // not on the host any more — it is 11M pixels of fma, floor and half-truncation a
+        // frame there, and publishing it here means the readback is the finished 14.7MB
+        // image rather than the head's 60MB of f32.
+        kernels->compositeToRgba8(commands, proxy, graph->head(), imageBuffer, workWidth, fullWidth,
+                                  workWidth, workHeight, motionBuffer,
+                                  haveHistory ? &historyProxy : nullptr, blendScale);
+        context->endAndSubmit(commands, true);
+        checkChainTimeouts(*kernels);
+        const std::chrono::steady_clock::time_point afterRecord = std::chrono::steady_clock::now();
+
+        // The head is read back for the diagnostic line. Frame 0's head is measured while
+        // the warm-up still dominates, so its numbers are the warm-up's and not the thing to
+        // compare against NGX; the default is therefore the run's last frame, which is steady
+        // state. DLSS5VK_SERVE_HEAD_FRAME overrides it with a frame index, or -1 to disable the
+        // readback. Its numbers are what says whether a wrong picture is the network diverging
+        // or the composite throwing a good head away; after that the picture is the only thing
+        // that leaves the device. The composite adds head/4 to the proxy (composeChannel), so
+        // the per-channel "residual" mean below is head.rgb/4: the quantity to compare, channel
+        // by channel, against NGX's measured delta. The fourth channel is the blend logit.
+        const char* headFrameValue = getenv("DLSS5VK_SERVE_HEAD_FRAME");
+        const long headFrame = headFrameValue
+            ? std::strtol(headFrameValue, nullptr, 10)
+            : (frameLimit > 0 ? (long)frameLimit - 1 : 0L);
+        if (headFrame >= 0 && (long)frames == headFrame) {
+          const std::vector<uint8_t> headBytes =
+              context->download(graph->head().buffer, (VkDeviceSize)fullWidth * fullHeight * 4 * 4);
+          const float* head = reinterpret_cast<const float*>(headBytes.data());
+          const size_t values = (size_t)fullWidth * fullHeight * 4;
+          size_t nonFinite = 0;
+          double sum = 0;
+          double channelSum[4] = {0, 0, 0, 0};
+          size_t channelCount[4] = {0, 0, 0, 0};
+          float low = INFINITY, high = -INFINITY;
+          for (size_t i = 0; i < values; ++i) {
+            const float v = head[i];
+            const size_t channel = i & 3u;
+            if (!std::isfinite(v)) { ++nonFinite; continue; }
+            low = std::fmin(low, v); high = std::fmax(high, v); sum += v;
+            channelSum[channel] += v; ++channelCount[channel];
+          }
+          const double mean[4] = {
+              channelSum[0] / (double)(channelCount[0] ? channelCount[0] : 1),
+              channelSum[1] / (double)(channelCount[1] ? channelCount[1] : 1),
+              channelSum[2] / (double)(channelCount[2] ? channelCount[2] : 1),
+              channelSum[3] / (double)(channelCount[3] ? channelCount[3] : 1)};
+          fprintf(stderr, "serve: head %.4f..%.4f mean %.5f; residual mean %.4f %.4f %.4f "
+                          "(rgb, head/4), logit mean %.4f; non-finite %zu of %zu; first 8",
+                  low, high, nonFinite ? sum / (double)(values - nonFinite) : sum / (double)values,
+                  mean[0] / 4.0, mean[1] / 4.0, mean[2] / 4.0, mean[3],
+                  nonFinite, values);
+          for (int i = 0; i < 8; ++i) fprintf(stderr, " %.4f", head[i]);
+          fprintf(stderr, "\n");
+        }
+
+        const std::vector<uint8_t> image =
+            context->download(imageBuffer, (VkDeviceSize)workWidth * workHeight * 4);
+        const std::chrono::steady_clock::time_point afterDownload = std::chrono::steady_clock::now();
+        frames++;
+        const std::vector<uint8_t>* inlinePixels = nullptr;
+        uint32_t replyBytes = 0;
+        publishImage(output, image, &inlinePixels, &replyBytes);
+        sendFrame(index, 1, replyBytes, 0, pts, inlinePixels);
+        // What this frame published is the history the next frame reads.
+        haveHistory = true;
+        const std::chrono::steady_clock::time_point afterSend = std::chrono::steady_clock::now();
+
+        auto since = [](const std::chrono::steady_clock::time_point& from,
+                        const std::chrono::steady_clock::time_point& to) {
+          return std::chrono::duration<double, std::milli>(to - from).count();
+        };
+        const double ms = since(began, afterSend);
+        totalMs += ms;
+        // The breakdown, because the total alone cannot say whether this is the network
+        // or what this mode does around it: the head is 16 bytes per padded pixel, so the
+        // readback alone is 60MB at 1440p, and whether that costs 6ms or 600ms decides
+        // where the next hour goes. Printed for the first few frames (where the JIT lands)
+        // and then sparsely.
+        if (frames <= 3 || frames % 30 == 0)
+          fprintf(stderr,
+                  "serve frame %u: %.1f ms (proxy %.1f, network+composite %.1f, readback %.1f, "
+                  "reply %.1f)\n",
+                  index, ms, since(began, afterUpload), since(afterUpload, afterRecord),
+                  since(afterRecord, afterDownload), since(afterDownload, afterSend));
+      }
+
+      if (frameLimit > 0 && (int)frames >= frameLimit) {
+        fprintf(stderr, "serve: %u frames, %.2f ms mean, stopping as asked\n", frames, totalMs / (double)frames);
+        return 0;
+      }
+    }
+  } catch (const std::exception& error) {
+    fprintf(stderr, "serve: %s\n", error.what());
+    return 1;
+  }
+}
