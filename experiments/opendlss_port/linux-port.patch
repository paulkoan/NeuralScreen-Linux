diff --git a/scripts/build_linux.sh b/scripts/build_linux.sh
new file mode 100755
index 0000000..e16bc4d
--- /dev/null
+++ b/scripts/build_linux.sh
@@ -0,0 +1,161 @@
+#!/usr/bin/env bash
+# Build dlss5vk on Linux. Mirrors scripts/build.ps1 (host) + scripts/build_shaders.ps1
+# (shaders and PTX) with the same pinned deps, so the two produce the same artifact.
+#
+# What differs from Windows, and why:
+#   * volk.c is C, so gcc compiles it; g++ compiling it as C++ pulls in errors that
+#     have nothing to do with this project.
+#   * glslang comes from the system (or $GLSLANG) instead of tools/glslang/bin/glslang.exe.
+#   * -DVK_ENABLE_BETA_EXTENSIONS is required on both: VK_NV_cuda_kernel_launch lives
+#     behind it in vulkan_beta.h.
+#   * the MSVC-only defines (NOMINMAX, WIN32_LEAN_AND_MEAN, _CRT_SECURE_NO_WARNINGS)
+#     are dropped, since nothing in src/ is Windows-specific.
+set -euo pipefail
+root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$root"
+
+JOBS="${JOBS:-$(nproc)}"
+CXX="${CXX:-g++}"
+CC="${CC:-gcc}"
+GLSLANG="${GLSLANG:-$(command -v glslang || command -v glslangValidator || true)}"
+
+# --- toolchain ---------------------------------------------------------------
+# fetch_tools.ps1 downloads Vulkan-Headers and volk into tools/ (glslang too, as
+# a Windows release zip). On Linux they are two shallow clones at the same pinned
+# tags, and glslang is expected from the system. Fetching them here rather than
+# only documenting it is the difference between "go build it" and a cc1 error
+# about tools/volk/volk.c that says nothing about why it is missing.
+VULKAN_HEADERS_TAG="${VULKAN_HEADERS_TAG:-v1.4.363}"
+VOLK_TAG="${VOLK_TAG:-vulkan-sdk-1.4.357.0}"
+fetch_dep() {   # repo, tag, directory, file that proves it is there
+  [ -e "$3/$4" ] && return 0
+  echo "fetching $1 at $2 -> $3"
+  git clone --depth 1 --branch "$2" -q "https://github.com/$1.git" "$3" \
+    || { echo "could not fetch $1 (no network?): tools/ is required" >&2; exit 1; }
+  [ -e "$3/$4" ] || { echo "$1 fetched but $3/$4 is absent" >&2; exit 1; }
+}
+fetch_dep KhronosGroup/Vulkan-Headers "$VULKAN_HEADERS_TAG" tools/Vulkan-Headers include/vulkan/vulkan.h
+fetch_dep zeux/volk                   "$VOLK_TAG"            tools/volk            volk.c
+
+inc=(-I"$root/tools/Vulkan-Headers/include" -I"$root/tools/volk" -I"$root/src" -I"$root/build")
+flags=(-std=c++20 -O2 -DVK_ENABLE_BETA_EXTENSIONS -pthread)
+
+mkdir -p build/obj build/shaders build/ptx
+
+# --- shaders -----------------------------------------------------------------
+if [ -z "$GLSLANG" ]; then
+  echo "no glslang found: install it (glslang-tools / glslang on Arch) or set GLSLANG=" >&2
+  echo "skipping shader compilation; the host still builds" >&2
+else
+  echo "glslang: $GLSLANG ($("$GLSLANG" --version 2>/dev/null | head -1))"
+  failed=0
+  for f in shaders/*.comp; do
+    out="build/shaders/$(basename "${f%.comp}").spv"
+    "$GLSLANG" -V --target-env vulkan1.3 -I"$root/shaders" "$f" -o "$out" || failed=1
+  done
+  [ "$failed" -eq 0 ] || { echo "shader compilation failed" >&2; exit 1; }
+  echo "shaders -> build/shaders ($(ls build/shaders/*.spv | wc -l) modules)"
+fi
+
+# --- PTX kernels (VK_NV_cuda_kernel_launch) ----------------------------------
+# Straight from build_shaders.ps1: the emitters are Python and portable, so the
+# same invocations produce the same PTX.
+gen() { python3 "$root/scripts/ptx/$1" "${@:2}"; }
+for k in 64 128 256; do
+  gen mlp_e4m3.py "$k" "build/ptx/mlp_e4m3_K$k.ptx" 3 1 1
+done
+for c in 64 128 256 512; do
+  gen qkv_e4m3.py "$c" "build/ptx/qkv_e4m3_K$c.ptx" 80
+done
+for k in 32 64 128 256 512 1024; do
+  for f in 5 13 4 8 6; do
+    gen gemm2_e4m3.py "$k" "$f" "build/ptx/gemm2_e4m3_K${k}_f$f.ptx"
+  done
+done
+for cfg in "64 4 0" "128 4 0" "256 3 80" "256 4 64"; do
+  set -- $cfg
+  gen ffn_e4m3.py "$1" "$2" "build/ptx/ffn_e4m3_C$1_R$2.ptx" "$3"
+  gen ffn_e4m3.py "$1" "$2" "build/ptx/ffn_e4m3_C$1_R$2_proj.ptx" "$3" 1
+done
+for cfg in "4096 1 32 4" "1024 0 16 2" "1024 1 8 4" "1024 0 8 4"; do
+  set -- $cfg
+  gen gemmt_e4m3.py "$1" "$2" "$3" "$4" "build/ptx/gemmt_e4m3_K$1_f$2_p$3_s$4.ptx"
+done
+for cfg in "4 4" "2 8" "4 8"; do
+  set -- $cfg
+  gen reduce_e4m3.py "$1" "$2" "build/ptx/reduce_e4m3_s$1_f$2.ptx"
+done
+for cfg in "1024 6 1" "4096 5 4" "1024 8 2" "1024 5 4"; do
+  set -- $cfg
+  gen gemmv_e4m3.py "$1" "$2" "$3" "build/ptx/gemmv_e4m3_K$1_f$2_s$3.ptx"
+  gen gemmv_e4m3.py "$1" "$2" "$3" "build/ptx/gemmv_e4m3_K$1_f$2_s$3_m96.ptx" 4 6 0 0 0 96
+done
+for p in 64 128 192 256; do
+  gen global_attention_e4m3.py "$p" "build/ptx/global_attention_e4m3_p$p.ptx"
+done
+gen global_attention_stream_e4m3.py normalize build/ptx/global_normalize_e4m3.ptx
+gen global_attention_stream_e4m3.py attention build/ptx/global_attention_stream_e4m3.ptx 4
+# split-512 GEMMs through gemmv (96-row tiles, no partition): layer 0 (E4), contract
+# (residual + E4), projection (dual); plus the unsplit ViT shapes of high resolutions
+# (many token row groups): contract K4096 f5, qkv K1024 f8, projection K1024 f5
+for cfg in "512 4" "512 5" "512 13" "256 5" "4096 5" "1024 8" "1024 5"; do
+  set -- $cfg
+  gen gemmv_e4m3.py "$1" "$2" 1 "build/ptx/gemmv_e4m3_K$1_f$2_s1_m96.ptx" 4 6 0 0 0 96
+done
+# fused 32-channel block variants: E4 out; E4 + pool; pre + E4 + pool; upres + E4; post + head
+for f in 2 66 74 130 48; do
+  gen block32_e4m3.py "$f" "build/ptx/block32_e4m3_f$f.ptx"
+done
+
+# Every emitter invocation in build_shaders.ps1 has to be here. A short list is not a
+# build failure on its own: the host resolves kernels by name at run time, so a missing
+# one surfaces there as "cannot read PTX kernel ..." the first time that dispatch is
+# reached — a whole model in, on the GPU box, with nothing pointing back at this script.
+# 78 is what the ps1 emits; if the two drift, fix this script rather than the number.
+EXPECTED_PTX=78
+ptx_count=$(ls build/ptx/*.ptx 2>/dev/null | wc -l)
+[ "$ptx_count" -eq "$EXPECTED_PTX" ] || {
+  echo "PTX: built $ptx_count of $EXPECTED_PTX kernels. build_shaders.ps1 is the list;" >&2
+  echo "a missing kernel fails at run time with 'cannot read PTX kernel', not here." >&2
+  exit 1
+}
+echo "PTX -> build/ptx ($ptx_count kernels)"
+
+# --- build stamp -------------------------------------------------------------
+# What this binary was built from, written into the binary rather than inferred later.
+# An apply that failed once left the previous build in place and the run said nothing
+# about it: the console showed a stale binary doing something the current sources do not
+# do, and the only way to find out was to guess. `dlss5vk stamp` prints this line, serve
+# logs it at startup, and the pipeline compares it against the patch its own checkout
+# carries — so "are we in sync" is answered by the artifact, not by anyone's memory.
+PORT_COMMIT="$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown)"
+PORT_MODIFIED="$(git -C "$root" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
+PATCH_ID="$(cat "$root/.ns-patch-id" 2>/dev/null || echo unset)"
+cat > build/stamp.h <<STAMP
+#pragma once
+#define DLSS5VK_PORT_COMMIT "$PORT_COMMIT"
+#define DLSS5VK_PORT_MODIFIED "$PORT_MODIFIED"
+#define DLSS5VK_PATCH_ID "$PATCH_ID"
+STAMP
+echo "stamp -> port $PORT_COMMIT, $PORT_MODIFIED modified file(s), patch $PATCH_ID"
+
+# --- host --------------------------------------------------------------------
+# VK_ENABLE_BETA_EXTENSIONS must reach volk.c as well as src/: volk.h gates the
+# VK_NV_cuda_kernel_launch entry points behind it, so without it on this one file
+# volk never defines the pointers the sources reference and the link fails with
+# five undefined references. The PowerShell build gets this for free by compiling
+# volk.c in the same cl invocation as everything else.
+"$CC" -O2 -DVK_ENABLE_BETA_EXTENSIONS -c tools/volk/volk.c -o build/obj/volk.o \
+  -I"$root/tools/volk" -I"$root/tools/Vulkan-Headers/include"
+
+objs=()
+for f in src/*.cpp; do
+  o="build/obj/$(basename "${f%.cpp}").o"
+  "$CXX" "${flags[@]}" "${inc[@]}" -c "$f" -o "$o" &
+  objs+=("$o")
+  while [ "$(jobs -rp | wc -l)" -ge "$JOBS" ]; do wait -n || { echo "compile failed" >&2; exit 1; }; done
+done
+wait
+
+"$CXX" "${objs[@]}" build/obj/volk.o -o build/dlss5vk -pthread -ldl
+echo "built $root/build/dlss5vk"
diff --git a/shaders/composite_serve.comp b/shaders/composite_serve.comp
new file mode 100644
index 0000000..99efd96
--- /dev/null
+++ b/shaders/composite_serve.comp
@@ -0,0 +1,69 @@
+#version 460
+// The serve path's composite: the network's head and the proxy image in, RGBA8 out.
+//
+// Same arithmetic as the host spelling in src/main.cpp (`composed`) and the demo's
+// nr_composite.comp, so what this publishes is what the parity gate compares against:
+//
+//   neural = clamp(proxy + head / 4, 0, 1)      published through the half grid
+//
+// It exists because the host spelling of that is ~130ms a frame at 1440p — 11M pixels by
+// three channels of fma, floor and half-truncation — and because the head is 16 bytes per
+// padded pixel, so publishing it on the host means reading 60MB back per frame where the
+// finished image is 14.7MB. Here it is one dispatch and the readback is the picture.
+//
+// The truncation to the half grid is the composite's publication of the neural result
+// (`truncateHalf` in src/main.cpp): toward zero, not to nearest, so it cannot be spelled
+// with roundF16 and is done on the bits.
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(push_constant) uniform Push {
+  uint proxyWidth;    // the proxy's stride: frames are uploaded at the valid size
+  uint headWidth;     // the head's stride: rows are padded to a multiple of 64
+  uint validWidth;
+  uint validHeight;
+} pc;
+
+layout(std430, binding = 0) readonly buffer Proxy { vec4 proxy[]; };
+layout(std430, binding = 6) readonly buffer Head { vec4 head[]; };
+layout(std430, binding = 7) writeonly buffer Out { uint pixels[]; };   // RGBA8, little-endian
+
+float truncateHalf(float value) {
+  uint bits = floatBitsToUint(value);
+  uint signBit = (bits >> 16u) & 0x8000u;
+  uint exponent = (bits >> 23u) & 0xffu;
+  uint mantissa = bits & 0x7fffffu;
+  uint halfBits;
+  if (exponent == 0xffu) halfBits = signBit | (mantissa != 0u ? 0x7e00u : 0x7c00u);
+  else {
+    int halfExponent = int(exponent) - 112;
+    if (halfExponent >= 31) halfBits = signBit | 0x7c00u;
+    else if (halfExponent <= 0)
+      halfBits = halfExponent < -10 ? signBit
+                                    : signBit | ((mantissa | 0x800000u) >> uint(14 - halfExponent));
+    else halfBits = signBit | (uint(halfExponent) << 10u) | (mantissa >> 13u);
+  }
+  return unpackHalf2x16(halfBits).x;
+}
+
+float composeChannel(float headValue, float centredProxy) {
+  const float inner = fma(headValue, 0.03125, centredProxy);       // head / 32 + centred
+  return truncateHalf(clamp(inner * 8.0 + 0.5, 0.0, 1.0));         // proxy + head / 4
+}
+
+uint toByte(float value) {
+  return uint(clamp(floor(value * 255.0 + 0.5), 0.0, 255.0));
+}
+
+void main() {
+  uvec2 id = gl_GlobalInvocationID.xy;
+  if (id.x >= pc.validWidth || id.y >= pc.validHeight) return;
+  vec4 source = proxy[id.y * pc.proxyWidth + id.x];
+  vec4 neural = head[id.y * pc.headWidth + id.x];
+  vec3 centred = fma(source.rgb, vec3(0.125), vec3(-0.0625));
+  vec3 value = vec3(composeChannel(neural.r, centred.r),
+                    composeChannel(neural.g, centred.g),
+                    composeChannel(neural.b, centred.b));
+  uvec3 bytes = uvec3(toByte(value.r), toByte(value.g), toByte(value.b));
+  pixels[id.y * pc.validWidth + id.x] =
+      bytes.r | (bytes.g << 8u) | (bytes.b << 16u) | (255u << 24u);
+}
\ No newline at end of file
diff --git a/shaders/preprocess.comp b/shaders/preprocess.comp
index 97edc1b..b5f247b 100644
--- a/shaders/preprocess.comp
+++ b/shaders/preprocess.comp
@@ -2,7 +2,8 @@
 // Input feature generation. Sixteen f32 lanes per padded pixel:
 // three Box-Muller Gaussian lanes evaluated with the GPU's approximate f32
 // transcendentals, constant 1, the centered proxy
-// color twice (the second copy is the history when temporal input is valid),
+// color twice (the second copy is the previous frame's output - lanes 7-9, the history -
+// when the caller has one, and the current proxy when it does not),
 // and the five conditioning lanes.
 #extension GL_EXT_shader_explicit_arithmetic_types : require
 #extension GL_GOOGLE_include_directive : require
@@ -23,9 +24,14 @@ layout(push_constant) uniform Push {
   float localStructure;
   float skinStructure;
   float style;
+  uint historyValid;     // 1: lanes 7-9 are sampled from History, 0: they repeat the current proxy
 } pc;
 
 layout(std430, binding = 0) readonly buffer Source { vec4 proxy[]; };   // RGBA f32 proxy code values
+// The previous frame's output through the same transform, in the same layout (the serve path
+// builds it with proxy_expand.comp, which is why the index below is the source one).
+// Without a history the caller still binds a buffer here and says historyValid = 0.
+layout(std430, binding = 1) readonly buffer History { vec4 history[]; };
 layout(std430, binding = 7) writeonly buffer Features { float features[]; };
 
 float hashUniform(uint value) {
@@ -77,9 +83,21 @@ void main() {
   features[base + 4u] = r;
   features[base + 5u] = g;
   features[base + 6u] = b;
-  features[base + 7u] = r;
-  features[base + 8u] = g;
-  features[base + 9u] = b;
+  // Lanes 7-9: the same transform applied to the reprojected previous output (docs/frame.md).
+  // This path is handed no motion field, so the reprojection is the identity and the history is
+  // the previous frame's output at this same pixel. Where there is no history - the first frame,
+  // or one that carried a reset - the current proxy stands in, as the demo's nr_preprocess.comp
+  // does for a pixel without one.
+  float historyR = r, historyG = g, historyB = b;
+  if (pc.historyValid != 0u) {
+    vec4 previous = history[imageY * pc.sourceWidth + imageX];
+    historyR = roundF16(roundF16(roundF16(previous.r) - 0.5) * 0.125);
+    historyG = roundF16(roundF16(roundF16(previous.g) - 0.5) * 0.125);
+    historyB = roundF16(roundF16(roundF16(previous.b) - 0.5) * 0.125);
+  }
+  features[base + 7u] = historyR;
+  features[base + 8u] = historyG;
+  features[base + 9u] = historyB;
   features[base + 10u] = pc.style / 128.0;
   features[base + 11u] = roundF16(pc.localTone);
   features[base + 12u] = roundF16(pc.autoMask > 0.0 ? 1.0 : pc.localStructure);
diff --git a/shaders/proxy_expand.comp b/shaders/proxy_expand.comp
new file mode 100644
index 0000000..fff90c9
--- /dev/null
+++ b/shaders/proxy_expand.comp
@@ -0,0 +1,32 @@
+#version 460
+// RGBA8 in, the f32 proxy out — what preprocess.comp reads.
+//
+// The proxy used to be built on the host: 11M float writes a frame, then 14.7MB uploaded
+// for the network to read. Here the upload is the camera's own 8-bit frame (3.7MB, a
+// quarter of the bytes) and the expansion is one dispatch.
+//
+// No rounding to f16 here on purpose: preprocess.comp rounds the proxy itself
+// (`roundF16(roundF16(roundF16(rgba.r) - 0.5) * 0.125)`), so rounding it here would be the
+// same work done twice, which is what the host loop was doing.
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(push_constant) uniform Push {
+  uint width;
+  uint height;
+  uint pad0;
+  uint pad1;
+} pc;
+
+layout(std430, binding = 0) readonly buffer Source { uint pixels[]; };   // RGBA8, little-endian
+layout(std430, binding = 6) writeonly buffer Proxy { vec4 proxy[]; };
+
+void main() {
+  uvec2 id = gl_GlobalInvocationID.xy;
+  if (id.x >= pc.width || id.y >= pc.height) return;
+  const uint packed = pixels[id.y * pc.width + id.x];
+  const float k = 1.0 / 255.0;
+  proxy[id.y * pc.width + id.x] = vec4(float(packed % 256u) * k,
+                                       float((packed / 256u) % 256u) * k,
+                                       float((packed / 65536u) % 256u) * k,
+                                       1.0);
+}
\ No newline at end of file
