+void Kernels::expandRgba8ToProxy(VkCommandBuffer commands, const vk::Buffer& source,
+                                const vk::Buffer& proxy, uint32_t width, uint32_t height) {
+  struct Push {
+    uint32_t width, height, pad0, pad1;
+  } push{width, height, 0, 0};
+  const vk::Buffer* bindings[vk::kGenericBindings] = {};
+  bindings[0] = &source;
+  bindings[6] = &proxy;
