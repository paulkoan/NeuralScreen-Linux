# Start the runner a few seconds after the last pass finished, and once at logging in.
#
# OnUnitInactiveSec rather than OnUnitActiveSec: the unit is oneshot, so this measures from
# the END of the previous run - a run that takes four minutes does not get a second pass
# started on top of it.
#
#   systemctl --user enable --now neuralscreen-runner.timer
#   systemctl --user list-timers neuralscreen-runner.timer
#   journalctl --user -u neuralscreen-runner.service -f
#
# To keep it running while you are logged out (a user command, not a root one):
#
#   loginctl enable-linger $USER

[Unit]
Description=Poll for NeuralScreen run requests

# 15s rather than 60: a pass is a fetch and usually the word "nothing queued", and the
# waiting is what a request feels as latency. There is no overlap risk to trade against it -
# the unit is oneshot, and OnUnitInactiveSec measures from the END of the previous pass, so a
# pass that takes 25 seconds (a slow fetch) simply delays the next one instead of stacking.
#
# It can go lower. 15s is chosen against GitHub's patience rather than the machine's: a pass
# is a few KB over ssh, so ~5,800 connections a day at 15s is civil, and one fetch per second
# would not be.
[Timer]
OnBootSec=30s
OnUnitInactiveSec=15s
AccuracySec=2s
Persistent=false

[Install]
WantedBy=timers.target
