# Start the runner a minute after the last pass finished, and once at boot.
#
# OnUnitInactiveSec rather than OnUnitActiveSec: the unit is oneshot, and this measures from
# the end of the previous run, so a run that takes four minutes does not get a second pass
# started on top of it.
#
#   sudo systemctl enable --now neuralscreen-runner.timer
#   systemctl list-timers neuralscreen-runner.timer
#   journalctl -u neuralscreen-runner.service -f

[Unit]
Description=Poll for NeuralScreen run requests

[Timer]
OnBootSec=2min
OnUnitInactiveSec=60s
AccuracySec=5s
Persistent=false

[Install]
WantedBy=timers.target
