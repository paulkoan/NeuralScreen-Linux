# The auto-runner, as a systemd USER unit. No root anywhere, nothing outside /opt/neuralscreen.
#
#   install -d -m 0755 /opt/neuralscreen /opt/neuralscreen/state
#   install -m 0755 tools/auto_runner.py /opt/neuralscreen/auto_runner.py
#   install -m 0644 tools/runner_policy.example.toml /opt/neuralscreen/policy.toml
#   install -d -m 0755 ~/.config/systemd/user
#   install -m 0644 tools/neuralscreen-runner.service tools/neuralscreen-runner.timer \
#        ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now neuralscreen-runner.timer
#
# The deploy key, generated on this machine so the private half never leaves it:
#
#   ssh-keygen -t ed25519 -C "neuralscreen-runner@(hostname)" -f ~/.ssh/neuralscreen-deploy
#   cat ~/.ssh/neuralscreen-deploy.pub
#
# Add the public half at github.com/paulkoan/NeuralScreen-Linux -> Settings -> Deploy keys ->
# Add deploy key, WITH "Allow write access" ticked. Then:
#
#   install -m 0600 ~/.ssh/neuralscreen-deploy /opt/neuralscreen/deploy_key
#   ssh -i /opt/neuralscreen/deploy_key -o IdentitiesOnly=yes \
#        -o UserKnownHostsFile=/opt/neuralscreen/state/known_hosts \
#        -o StrictHostKeyChecking=accept-new -T git@github.com
#
# ("Hi paulkoan! You've successfully authenticated" and no shell access is exactly right.)
#
# What lives outside the repository and cannot be changed by a commit: this unit, the policy,
# the deploy key and the executor copy in /opt/neuralscreen. A commit can only ask for
# something the policy already allows.

[Unit]
Description=NeuralScreen auto-runner (run requests in, results out)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/neuralscreen
ExecStart=/usr/bin/python3 /opt/neuralscreen/auto_runner.py --policy /opt/neuralscreen/policy.toml --once

# The deploy key and nothing else: no ssh agent, no other identities, and a known_hosts of
# its own under the state directory.
# No credential prompt, ever: under systemd there is nobody to answer one, so fail instead.
Environment="GIT_TERMINAL_PROMPT=0"
Environment="GIT_SSH_COMMAND=ssh -i /opt/neuralscreen/deploy_key -o IdentitiesOnly=yes -o UserKnownHostsFile=/opt/neuralscreen/state/known_hosts -o StrictHostKeyChecking=accept-new"

# --- the bounds ---------------------------------------------------------------------------
# These hold whatever a run request, or the code it runs, tries. The policy decides what is
# asked for; this section decides what is possible. They work in a user unit, which is why
# this does not need to be a system service.

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/neuralscreen
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# Writable-executable stays on: the GPU driver JITs, and the PTX kernels are compiled at run
# time.
MemoryDenyWriteExecute=no

# GitHub for the fetch and the push, and nothing else. localhost is in the list because of
# DNS: without it the resolver is unreachable, every fetch fails with "could not resolve
# host" and the cause looks like a credential problem. (With systemd-resolved the resolver is
# 127.0.0.53, which localhost covers.) If your systemd refuses these lines in a user unit,
# drop them: a run's own network access is decided separately, in the policy.
# AF_NETLINK is not optional: name resolution needs it, and without it every fetch fails
# with "Temporary failure in name resolution" while looking like a network outage.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressAllow=localhost github.com
IPAddressDeny=any

# --- bounds on a runaway -------------------------------------------------------------------
CPUQuota=400%
MemoryMax=12G
RuntimeMaxSec=1800
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
